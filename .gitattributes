# Normalize line endings on checkin, check out with LF everywhere.
# Without this, Windows checkouts reintroduce CRLF and every touched file
# shows up as fully rewritten in the next diff.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.tiff binary
*.ico binary
*.mp4 binary
*.webm binary
*.mov binary
*.woff binary
*.woff2 binary
*.pdf binary
