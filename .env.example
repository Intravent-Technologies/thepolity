# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ---------------------------------------------------------------------------

# Admin dashboard login.
# REQUIRED. There is no built-in default: if this is missing the admin login
# endpoint returns 503 and refuses every password, including any older one.
ADMIN_PASSWORD=<generate-a-long-random-password>

# REQUIRED. Signs the session cookie. Minimum 32 characters. Rotating it
# invalidates every active admin session immediately.
ADMIN_SESSION_SECRET=<generate-at-least-32-random-chars>

# Optional. Admin session lifetime in hours (default 8, capped at 24).
ADMIN_SESSION_TTL_HOURS=8

# Optional. Defaults to true in production, false otherwise. Set to false only
# when the site is served over plain HTTP, otherwise browsers will refuse to
# store the session cookie.
ADMIN_COOKIE_SECURE=

# Supabase.
# NEXT_PUBLIC_SUPABASE_URL is public by design. The service role key bypasses
# row level security entirely: server-side only, never prefix it with
# NEXT_PUBLIC_ and never paste it into source control.
#
# SUPABASE_URL is read as a server-side fallback for NEXT_PUBLIC_SUPABASE_URL.
# It is optional when the public one is set; define both if your host injects
# the project URL under different names.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=thepolity-media

# Google Drive, used to sync album folders.
#
# Create a key in Google Cloud Console, enable the Drive API on the project,
# then EDIT the key and restrict it to API = Drive API. That way a leak cannot
# reach any other Google service.
#
# Album folders must be shared "Anyone with the link" (Viewer). That public
# sharing is what lets a plain API key list them with no OAuth consent screen
# and no Google security assessment.
#
# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit it.
#
# Notes:
# - Photos are not downloaded. Their file ids are recorded and the browser
#   loads images from Google's CDN.
# - Videos are downloaded once and mirrored into SUPABASE_STORAGE_BUCKET,
#   because Drive serves media uncacheable and re-fetching it per visitor
#   invites rate limiting.
# - Sync is manual (the admin presses Sync), so the anonymous per-IP quota is
#   rarely a concern. If you ever see "anonymous daily quota is exhausted",
#   raise the Drive API quota for this project.
GOOGLE_DRIVE_API_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
