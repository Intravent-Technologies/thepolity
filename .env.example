# Admin Dashboard
# These are required — the app will throw at startup if missing.
# Set them in your Vercel project Environment Variables (Production,
# Preview, and Development environments).
ADMIN_PASSWORD=you-must-set-a-strong-password
ADMIN_SESSION_SECRET=you-must-set-a-long-random-secret

# Supabase (required for production writes/uploads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=thepolity-media

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
